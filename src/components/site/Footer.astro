---
/**
 * Site footer with links, social media, and copyright information
 * Optimized for mobile display and accessibility
 *
 * @component
 * @example
 * ```astro
 * <Footer />
 * ```
 */
import { socialLinks } from '../../data/config/navigation'
import { siteConfig } from '../../data/config/site'
import Container from './Container.astro'

const currentYear = new Date().getFullYear()
---

<footer class="content-visibility-auto border-t border-zinc-800 bg-zinc-900/50 py-12">
  <Container>
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div>
        <p class="text-zinc-400">
          {siteConfig.description}
        </p>
      </div>
      <div class="flex space-x-4">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-400 transition-colors hover:text-primary"
              aria-label={`Visit ${link.name}`}
            >
              <span class="sr-only">{link.name}</span>
              {link.icon === 'github' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden
                >
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
              )}
              {link.icon === 'twitter' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden
                >
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723 10.03 10.03 0 01-3.127 1.195 4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.92 4.92 0 001.522 6.574 4.903 4.903 0 01-2.229-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.224.084 4.92 4.92 0 004.6 3.42 9.863 9.863 0 01-7.277 2.035c2.148 1.379 4.7 2.182 7.44 2.182 8.921 0 13.81-7.394 13.81-13.805 0-.209-.005-.418-.014-.626a9.844 9.844 0 002.431-2.513z" />
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden
                >
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-10 border-t border-zinc-800 pt-8 text-center text-zinc-500">
      <p>&copy; {currentYear} Manuel Gil</p>
    </div>
  </Container>
</footer>
