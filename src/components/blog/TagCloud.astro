---
/**
 * Displays a cloud of blog post tags with count indicators
 *
 * This component renders a visually appealing tag cloud with:
 * - Interactive hover effects for better user feedback
 * - Accessible tag navigation with proper ARIA attributes
 * - Performance optimizations with content-visibility
 * - Visual indicators for the currently active tag
 *
 * @component
 * @example
 * ```astro
 * ---
 * import TagCloud from '../components/blog/TagCloud.astro';
 * import { getCollection } from 'astro:content';
 *
 * // Get all blog posts and extract their tags
 * const allPosts = await getCollection('blog');
 * const allTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))];
 *
 * // Count posts per tag
 * const tagCounts = allTags.reduce((acc, tag) => {
 *   acc[tag] = allPosts.filter(post => post.data.tags?.includes(tag)).length;
 *   return acc;
 * }, {} as Record<string, number>);
 * ---
 *
 * <TagCloud
 *   tags={allTags}
 *   counts={tagCounts}
 *   activeTag={Astro.params.tag as string}
 * />
 * ```
 */

import { slugifyTag } from '../../utils/slug-utils'

const {
  tags = [],
  counts = {},
  activeTag,
  title = 'Browse by Topic',
  showCounts = true,
} = Astro.props

// Sort tags alphabetically
const sortedTags = [...tags].sort()
---

{
  tags.length > 0 && (
    <div class="content-visibility-auto mb-12 rounded-xl border border-zinc-700 bg-zinc-800/50 p-6 shadow-xs">
      <h3 class="mb-4 text-xl font-bold">{title}</h3>

      <div class="flex flex-wrap gap-2">
        <a
          href="/blog"
          class={`rounded-full px-3 py-1 text-sm transition-all duration-300 will-change-transform
          ${
            !activeTag
              ? 'bg-primary/20 text-primary border border-primary/20 shadow-xs shadow-primary/10'
              : 'bg-zinc-700/30 text-zinc-300 hover:bg-zinc-700/50 hover:scale-105'
          }`}
        >
          All Posts
        </a>

        {sortedTags.map((tag) => (
          <a
            href={`/blog/tag/${slugifyTag(tag)}`}
            class={`rounded-full px-3 py-1 text-sm transition-all duration-300 will-change-transform
            ${
              activeTag === tag
                ? 'bg-primary/20 text-primary border border-primary/20 shadow-xs shadow-primary/10'
                : 'bg-zinc-700/30 text-zinc-300 hover:bg-zinc-700/50 hover:scale-105'
            }`}
            aria-current={activeTag === tag ? 'page' : undefined}
          >
            #{tag}
            {showCounts && counts[tag] && (
              <span class="ml-1 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-zinc-800/60 px-1 text-xs">
                {counts[tag]}
              </span>
            )}
          </a>
        ))}
      </div>
    </div>
  )
}

{
  tags.length === 0 && (
    <div class="mb-12 rounded-xl border border-zinc-700 bg-zinc-800/50 p-6 text-center">
      <p class="text-zinc-400">No tags found.</p>
    </div>
  )
}
