---
// Component that displays the estimated reading time
interface Props {
  readingTime: number
}

const { readingTime } = Astro.props
---

<div class="reading-time flex items-center gap-1 text-sm text-zinc-400">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="h-4 w-4 text-primary"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    aria-hidden="true"
    width="16"
    height="16"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
  </svg>
  <span>{readingTime} min read</span>
</div>
