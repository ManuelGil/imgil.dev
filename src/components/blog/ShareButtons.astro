---
// Component for social media sharing buttons
import { getCleanPathname } from '../../utils/url-utils'

interface Props {
  title: string
}

const { title } = Astro.props

// Get the current URL for sharing
const url = new URL(getCleanPathname(Astro.url.pathname), Astro.site).toString()

// Prepare sharing URLs
const shareUrls = {
  twitter: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
}
---

<div class="share-buttons relative flex items-center gap-2">
  <button
    id="share-button"
    class="flex items-center justify-center gap-1 rounded-full bg-zinc-800/80 px-4 py-2 text-sm font-medium text-zinc-200 transition-all hover:bg-zinc-700 hover:shadow-lg hover:shadow-primary/10 focus:outline-hidden focus:ring-2 focus:ring-primary/50"
    aria-label="Share this article"
    aria-expanded="false"
    aria-controls="share-dropdown"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4 text-primary"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
      width="16"
      height="16"
    >
      <path
        fill-rule="evenodd"
        d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
        clip-rule="evenodd"></path>
    </svg>
    Share
  </button>

  <div
    id="share-dropdown"
    class="absolute left-1/2 top-full z-10 mt-2 hidden w-48 -translate-x-1/2 rounded-md bg-zinc-800 p-2 shadow-lg ring-1 ring-black ring-opacity-5 backdrop-blur-xs transition-all"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="share-button"
  >
    <div class="space-y-1 py-1 text-center" role="none">
      <a
        href={shareUrls.twitter}
        id="share-twitter"
        class="flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm text-zinc-200 transition-colors hover:bg-zinc-700 focus:outline-hidden focus:ring-2 focus:ring-inset focus:ring-primary/50"
        target="_blank"
        rel="noopener noreferrer"
        role="menuitem"
        aria-label="Share on Twitter"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 text-[#1DA1F2]"
          fill="currentColor"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
        >
          <path
            d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
          ></path>
        </svg>
        Twitter
      </a>

      <a
        href={shareUrls.linkedin}
        id="share-linkedin"
        class="flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm text-zinc-200 transition-colors hover:bg-zinc-700 focus:outline-hidden focus:ring-2 focus:ring-inset focus:ring-primary/50"
        target="_blank"
        rel="noopener noreferrer"
        role="menuitem"
        aria-label="Share on LinkedIn"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 text-[#0A66C2]"
          fill="currentColor"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
        LinkedIn
      </a>

      <a
        href={shareUrls.facebook}
        id="share-facebook"
        class="flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm text-zinc-200 transition-colors hover:bg-zinc-700 focus:outline-hidden focus:ring-2 focus:ring-inset focus:ring-primary/50"
        target="_blank"
        rel="noopener noreferrer"
        role="menuitem"
        aria-label="Share on Facebook"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 text-[#1877F2]"
          fill="currentColor"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
        >
          <path
            d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
          ></path>
        </svg>
        Facebook
      </a>

      <button
        id="copy-link"
        class="flex w-full items-center justify-center gap-2 rounded-md px-4 py-2 text-sm text-zinc-200 transition-colors hover:bg-zinc-700 focus:outline-hidden focus:ring-2 focus:ring-inset focus:ring-primary/50"
        role="menuitem"
        aria-label="Copy link to clipboard"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 text-primary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          width="20"
          height="20"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"
          ></path>
        </svg>
        Copy Link
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const shareButton = document.getElementById('share-button')
    const shareDropdown = document.getElementById('share-dropdown')
    const copyLinkButton = document.getElementById('copy-link')

    // Toggle dropdown
    shareButton?.addEventListener('click', () => {
      const isExpanded = shareButton.getAttribute('aria-expanded') === 'true'
      shareButton.setAttribute('aria-expanded', (!isExpanded).toString())
      shareDropdown?.classList.toggle('hidden')
    })

    // Close dropdown when clicking outside
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement
      if (!target.closest('.share-buttons')) {
        shareButton?.setAttribute('aria-expanded', 'false')
        shareDropdown?.classList.add('hidden')
      }
    })

    // Handle copy link button
    copyLinkButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href)

        // Show success feedback
        const originalText = copyLinkButton.innerHTML
        copyLinkButton.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Copied!
        `

        // Reset after 2 seconds
        setTimeout(() => {
          copyLinkButton.innerHTML = originalText
        }, 2000)
      } catch (err) {
        console.error('Failed to copy link:', err)
      }
    })

    // Handle keyboard navigation
    shareDropdown?.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement
      const items = shareDropdown.querySelectorAll('[role="menuitem"]')
      const currentIndex = Array.from(items).indexOf(target as HTMLElement)

      switch (event.key) {
        case 'Escape':
          shareButton?.setAttribute('aria-expanded', 'false')
          shareDropdown.classList.add('hidden')
          shareButton?.focus()
          break
        case 'ArrowDown':
          event.preventDefault()
          if (currentIndex < items.length - 1) {
            ;(items[currentIndex + 1] as HTMLElement).focus()
          }
          break
        case 'ArrowUp':
          event.preventDefault()
          if (currentIndex > 0) {
            ;(items[currentIndex - 1] as HTMLElement).focus()
          }
          break
        case 'Home':
          event.preventDefault()
          ;(items[0] as HTMLElement).focus()
          break
        case 'End':
          event.preventDefault()
          ;(items[items.length - 1] as HTMLElement).focus()
          break
      }
    })
  })
</script>

<style>
  #share-dropdown {
    transform: translateY(-10px);
    opacity: 0;
    transition:
      transform 0.2s ease-out,
      opacity 0.2s ease-out;
    top: 100%;
  }

  #share-dropdown:not(.hidden) {
    transform: translateY(0);
    opacity: 1;
  }
</style>
