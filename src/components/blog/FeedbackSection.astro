---
// Component for collecting user feedback on articles
import { getEntryBySlug } from 'astro:content'

interface Props {
  slug: string
}

const { slug } = Astro.props
---

<div
  class="feedback-section mt-12 rounded-xl border border-zinc-800 bg-zinc-900/50 p-6 text-center"
>
  <h3 class="mb-4 text-xl font-bold text-zinc-100">Did you find this article helpful?</h3>

  <p class="mb-6 text-zinc-400">Your feedback helps me improve my content</p>

  <div class="flex justify-center gap-4">
    <button
      id="feedback-yes"
      class="feedback-btn flex items-center gap-2 rounded-full bg-zinc-800 px-4 py-2 font-medium text-zinc-200 transition-all hover:bg-zinc-700 hover:text-primary"
      data-slug={slug}
      data-value="yes"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
        width="20"
        height="20"
      >
        <path
          d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"
        ></path>
      </svg>
      Yes, it was helpful
    </button>

    <button
      id="feedback-no"
      class="feedback-btn flex items-center gap-2 rounded-full bg-zinc-800 px-4 py-2 font-medium text-zinc-200 transition-all hover:bg-zinc-700 hover:text-primary"
      data-slug={slug}
      data-value="no"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
        width="20"
        height="20"
      >
        <path
          d="M18 9.5a1.5 1.5 0 11-3 0v-6a1.5 1.5 0 013 0v6zM14 9.667v-5.43a2 2 0 00-1.105-1.79l-.05-.025A4 4 0 0011.055 2H5.64a2 2 0 00-1.962 1.608l-1.2 6A2 2 0 004.44 12H8v4a2 2 0 002 2 1 1 0 001-1v-.667a4 4 0 01.8-2.4l1.4-1.866a4 4 0 00.8-2.4z"
        ></path>
      </svg>
      No, it could be better
    </button>
  </div>

  <div id="feedback-message" class="mt-4 hidden text-center text-sm text-zinc-400"></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const feedbackBtns = document.querySelectorAll('.feedback-btn')
    const feedbackMessage = document.getElementById('feedback-message')

    // Check if feedback was already given for this article
    const checkPreviousFeedback = (slug) => {
      const storedFeedback = localStorage.getItem(`article_feedback_${slug}`)
      if (storedFeedback) {
        disableButtons()
        if (feedbackMessage) {
          feedbackMessage.textContent = 'Thank you for your previous feedback!'
          feedbackMessage.classList.remove('hidden')
        }
        return true
      }
      return false
    }

    // Disable all feedback buttons
    const disableButtons = () => {
      feedbackBtns.forEach((btn) => {
        ;(btn as HTMLButtonElement).disabled = true
        btn.classList.add('opacity-50', 'cursor-not-allowed')
        btn.classList.remove('hover:bg-zinc-700', 'hover:text-primary')
      })
    }

    // Handle feedback submission
    const handleFeedback = (e) => {
      const btn = e.currentTarget
      const slug = (btn as HTMLButtonElement).dataset.slug
      const value = btn.dataset.value

      // Check if feedback was already given
      if (checkPreviousFeedback(slug)) return

      // Save feedback to localStorage
      localStorage.setItem(`article_feedback_${slug}`, value)

      // Disable buttons and show thank you message
      disableButtons()
      if (feedbackMessage) {
        feedbackMessage.textContent = 'Thank you for your feedback!'
        feedbackMessage.classList.remove('hidden')
      }

      // Here you could send the feedback to your backend or analytics service
      console.log(`Feedback for ${slug}: ${value}`)
    }

    // Add click event listeners to buttons
    feedbackBtns.forEach((btn) => {
      const slug = (btn as HTMLButtonElement).dataset.slug

      // Check if feedback was already given
      if (!checkPreviousFeedback(slug)) {
        btn.addEventListener('click', handleFeedback)
      }
    })
  })
</script>

<style>
  .feedback-btn {
    transition: all 0.2s ease-in-out;
  }

  #feedback-message {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
