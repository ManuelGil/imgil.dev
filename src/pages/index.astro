---
/**
 * Home page - record of what exists and how it is carried
 */
import Hero from '../components/Hero.astro'
import Container from '../components/site/Container.astro'
import Section from '../components/site/Section.astro'
import SectionHeader from '../components/site/SectionHeader.astro'
import { siteConfig } from '../config/site'
import Layout from '../layouts/Layout.astro'
import { generateSeoMetadata } from '../utils/seo-metadata'

// Generate SEO metadata
const seo = generateSeoMetadata({
  title: `${siteConfig.emoji.home} ${siteConfig.name}`,
  description:
    'Building and carrying open source tools over time. Some are active, some are quiet, all are published with responsibility.',
})
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords="open source, developer tools, software development, TypeScript, Angular, VueJS, NestJS, Java, PHP"
>
  <Container className="pt-20 content-visibility-auto">
    <!-- Hero Section -->
    <Hero
      title="Open Source Tools, Carried Over Time"
      description={`I'm Manuel Gil. I build and carry open source developer tools - extensions, libraries, and utilities. Some are active, some are slow, some are quiet. I remain responsible for what I publish.`}
      centered={true}
      maxWidth="md"
    />

    <!-- What I Do Section -->
    <Section maxWidth="md">
      <SectionHeader title="What This Work Looks Like" />
      <div class="space-y-6">
        <p class="text-lg text-zinc-400">
          I started teaching myself to code at a young age. Over the years that turned into building
          tools - mostly VSCode extensions, npm packages, and small utilities - that other
          developers started using.
        </p>
        <p class="mt-4 text-lg text-zinc-400">
          Some of what I do now is maintenance - updating dependencies, fixing what breaks, keeping
          things compatible where I can. Not all projects get the same attention. Some are active,
          some are slow, some are carried quietly. I take responsibility for what I publish, but I
          don't offer support or guaranteed availability.
        </p>

        <div class="mt-12 grid gap-12 md:grid-cols-2">
          <div>
            <h3 class="mb-4 text-xl font-bold text-primary">What I Carry</h3>
            <ul class="space-y-2 text-zinc-400">
              <li class="flex items-center">
                <span class="mr-2 text-primary">▹</span>
                VSCode extensions used by other developers
              </li>
              <li class="flex items-center">
                <span class="mr-2 text-primary">▹</span>
                Libraries and starter kits published over time
              </li>
              <li class="flex items-center">
                <span class="mr-2 text-primary">▹</span>
                Maintenance work when time and capacity allow
              </li>
            </ul>
          </div>
          <div>
            <h3 class="mb-4 text-xl font-bold text-primary">How I Work</h3>
            <ul class="space-y-2 text-zinc-400">
              <li class="flex items-center">
                <span class="mr-2 text-primary">▹</span>
                I use AI, forks, and messy workflows - but I review what ships
              </li>
              <li class="flex items-center">
                <span class="mr-2 text-primary">▹</span>
                I work alone on most of this, with limited time
              </li>
              <li class="flex items-center">
                <span class="mr-2 text-primary">▹</span>
                I prioritize keeping things stable over adding features
              </li>
            </ul>
          </div>
        </div>
      </div>
    </Section>

    <!-- Projects Section -->
    <Section id="projects">
      <SectionHeader title="Projects" />
      <p class="text-zinc-400">
        Extensions, libraries and small utilities I've built and kept around over the years -
        some still active, some archived, all of them still up.
      </p>
      <a
        href="/open-source-projects"
        class="mt-6 inline-block text-primary transition-colors hover:text-primary-dark"
      >
        All projects →
      </a>
    </Section>

    <!-- Talks Section -->
    <Section id="talks">
      <SectionHeader title="Talks" />
      <p class="mb-6 text-lg text-zinc-400">
        I've spoken at events like <strong class="text-zinc-200">CCOSS</strong>, <strong
          class="text-zinc-200">FLISoL</strong
        >, and <strong class="text-zinc-200">Nerdearla</strong>, mostly about open source and the
        tools I've built. I do it when I have something worth sharing, not on a schedule.
      </p>
      <a href="/talks-communities" class="text-primary transition-colors hover:text-primary-dark">
        More about talks →
      </a>
    </Section>

    <!-- Support Section -->
    <Section id="support">
      <SectionHeader
        title="Support"
        description="If these tools are useful to you and you want them to keep existing, you can help."
      />
      <p class="mb-6 text-lg text-zinc-400">
        Sponsorship doesn't buy features, access, or priority. It helps offset the personal time and
        cost of carrying these tools forward.
      </p>
      <div class="flex space-x-4">
        <a
          href="https://github.com/sponsors/ManuelGil"
          class="text-primary transition-colors hover:text-primary-dark"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub Sponsors →
        </a>
        <a
          href="https://www.buymeacoffee.com/ManuelGil"
          class="text-zinc-400 transition-colors hover:text-zinc-200"
          target="_blank"
          rel="noopener noreferrer"
        >
          Buy me a coffee →
        </a>
      </div>
    </Section>

    <!-- Contact Section -->
    <Section id="contact">
      <SectionHeader title="Where to Find Me" />
      <ul class="space-y-4">
        <li>
          <a
            href="https://github.com/ManuelGil"
            class="text-zinc-400 transition-colors hover:text-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/imgildev"
            class="text-zinc-400 transition-colors hover:text-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
        </li>
        <li>
          <a
            href="https://twitter.com/imgildev"
            class="text-zinc-400 transition-colors hover:text-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Twitter
          </a>
        </li>
      </ul>
    </Section>
  </Container>
</Layout>
