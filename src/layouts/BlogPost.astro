---
import { format } from 'date-fns'
import Layout from './Layout.astro'
import '../styles/prism-theme.css'

// Import blog components
import ReadingProgressBar from '../components/blog/ReadingProgressBar.astro'
import TableOfContents from '../components/blog/TableOfContents.astro'
import ShareButtons from '../components/blog/ShareButtons.astro'
import RelatedPosts from '../components/blog/RelatedPosts.astro'
import ReadingTime from '../components/blog/ReadingTime.astro'
import FeedbackSection from '../components/blog/FeedbackSection.astro'

// Calculate reading time
function calculateReadingTime(content) {
  const wordCount = content.split(/\s+/).length
  const readingTime = Math.ceil(wordCount / 200)
  return readingTime
}

interface Props {
  title: string
  description: string
  pubDate?: Date
  updatedDate?: Date
  heroImage?: string
  author?: string
  keywords?: string
  tags?: string[]
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  author = 'Manuel Gil',
  keywords,
  tags = [],
} = Astro.props

// Get the current URL for sharing
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

// Get the content for reading time calculation
const content = await Astro.slots.render('default')
const readingTime = calculateReadingTime(content)

// Format dates
const formattedPubDate = pubDate ? format(new Date(pubDate), 'MMMM d, yyyy') : ''
const formattedUpdatedDate = updatedDate ? format(new Date(updatedDate), 'MMMM d, yyyy') : ''
---

<Layout title={title} description={description} keywords={keywords || `blog,${title}`}>
  <ReadingProgressBar />

  <article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-12">
      {
        heroImage && (
          <div class="mb-8 overflow-hidden rounded-2xl shadow-xl">
            <img
              src={heroImage}
              alt={title}
              class="h-auto w-full object-cover"
              width="1200"
              height="630"
            />
          </div>
        )
      }

      <div class="text-center">
        <h1
          class="mb-4 bg-gradient-to-r from-white to-zinc-300 bg-clip-text text-4xl font-bold leading-tight text-transparent sm:text-5xl md:text-6xl"
        >
          {title}
        </h1>

        <p class="mx-auto mb-6 max-w-2xl text-lg text-zinc-400">
          {description}
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-zinc-400">
          {
            pubDate && (
              <div class="flex items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 text-primary"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                  width="16"
                  height="16"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
                <span>{formattedPubDate}</span>
              </div>
            )
          }

          {
            updatedDate && (
              <div class="flex items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 text-primary"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                  width="16"
                  height="16"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  />
                </svg>
                <span>Updated on {formattedUpdatedDate}</span>
              </div>
            )
          }

          <ReadingTime readingTime={readingTime} />

          <div class="flex items-center gap-1">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-primary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              width="16"
              height="16"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            <span>{author}</span>
          </div>
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div
          class="prose prose-invert max-w-none prose-headings:font-bold prose-headings:text-zinc-100 prose-h1:text-3xl prose-h1:leading-tight prose-h2:mt-10 prose-h2:text-2xl prose-h3:text-xl prose-p:text-zinc-300 prose-a:text-primary prose-a:no-underline hover:prose-a:text-primary/80 prose-blockquote:border-l-primary prose-blockquote:bg-zinc-800/50 prose-blockquote:p-4 prose-blockquote:not-italic prose-ol:my-6 prose-ol:list-decimal prose-ol:pl-6 prose-ul:my-6 prose-ul:list-disc prose-ul:pl-6 prose-li:my-2 prose-li:text-zinc-100 prose-li:marker:text-primary"
        >
          <div class="article-content">
            <slot />
          </div>

          <!-- Feedback section -->
          <!-- <FeedbackSection slug={Astro.url.pathname} /> -->
        </div>

        <div class="hidden lg:block">
          <div class="sticky top-24">
            <div class="rounded-xl border border-zinc-800/50 bg-zinc-900/30 p-6 backdrop-blur-sm">
              <h4 class="mb-4 text-lg font-semibold text-white">Table of Contents</h4>
              <TableOfContents />
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 flex justify-center">
        <ShareButtons title={title} />
      </div>

      {
        tags && tags.length > 0 && (
          <div class="mt-12">
            <RelatedPosts tags={tags} currentSlug={Astro.url.pathname} />
          </div>
        )
      }
    </div>
  </article>

  <script>
    // Initialize PrismJS for code highlighting
    document.addEventListener('DOMContentLoaded', () => {
      // Add copy button to code blocks
      const codeBlocks = document.querySelectorAll('pre')

      codeBlocks.forEach((codeBlock) => {
        // Create copy button
        const copyButton = document.createElement('button')
        copyButton.className = 'copy-code-button'
        copyButton.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="20" height="20" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      `

        // Add copy button to code block
        codeBlock.appendChild(copyButton)

        // Add click event to copy button
        copyButton.addEventListener('click', () => {
          const code = codeBlock.querySelector('code')
          if (!code) return

          // Copy code to clipboard
          navigator.clipboard
            .writeText(code.textContent || '')
            .then(() => {
              // Show success state
              copyButton.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="20" height="20" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            `

              // Reset after 2 seconds
              setTimeout(() => {
                copyButton.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="20" height="20" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              `
              }, 2000)
            })
            .catch((err) => {
              console.error('Failed to copy code:', err)
            })
        })
      })
    })
  </script>

  <style>
    .copy-code-button {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      padding: 0.25rem;
      background-color: rgba(30, 30, 30, 0.5);
      border-radius: 0.25rem;
      border: none;
      cursor: pointer;
      color: #d4d4d8;
      transition: all 0.2s ease;
    }

    .copy-code-button:hover {
      background-color: rgba(50, 50, 50, 0.8);
      color: white;
    }

    pre {
      position: relative;
      padding: 1.5rem;
      border-radius: 0.5rem;
      margin: 1.5rem 0;
      background-color: #1e1e1e !important;
      overflow-x: auto;
    }
  </style>
</Layout>
