---
import '../styles/global.css'

interface Props {
  title: string
  description: string
  keywords: string
}

const { title, description, keywords } = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Manuel Gil" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ff6b00" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>

    <!-- Precconnect and DNS Prefetch -->
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />
    <link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://imgil.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://avatars.githubusercontent.com/u/25472045" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://imgil.dev/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://avatars.githubusercontent.com/u/25472045" />

    <link rel="canonical" href="https://imgil.dev/" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Manuel Gil",
        "url": "https://imgil.dev/",
        "sameAs": [
          "https://www.linkedin.com/in/imgildev",
          "https://github.com/ManuelGil",
          "https://twitch.tv/imgildev",
          "https://youtube.com/@imgildev",
          "https://twitter.com/imgildev"
        ],
        "jobTitle": "Indie Maker & Open Source Developer",
        "description": "I build Open Source tools, create VSCode extensions and share knowledge in the community.",
        "image": "https://avatars.githubusercontent.com/u/25472045"
      }
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const menuToggle = document.getElementById('menu-toggle')
        const mobileMenu = document.getElementById('mobile-menu')

        if (menuToggle && mobileMenu) {
          menuToggle.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden')
          })
        }

        // Fix for Chrome navigation issues
        const links = document.querySelectorAll('a[href^="/"]')
        links.forEach((link) => {
          link.addEventListener('click', (event) => {
            const mouseEvent = event as MouseEvent
            const href = link.getAttribute('href')
            // Only handle internal links without modifier keys
            if (href && href.startsWith('/') && !mouseEvent.ctrlKey && !mouseEvent.metaKey) {
              event.preventDefault()
              window.location.href = href
            }
          })
        })
      })
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-zinc-900 text-white">
    <header
      class="fixed top-0 z-50 w-full border-b border-zinc-800 bg-zinc-900/80 backdrop-blur-sm"
    >
      <nav class="container mx-auto px-4 py-3">
        <div class="flex items-center justify-between md:hidden">
          <a href="/" class="text-xl font-bold text-zinc-100 transition-colors hover:text-primary"
            >Manuel Gil</a
          >
          <button
            id="menu-toggle"
            class="rounded-lg p-2 text-zinc-400 transition-all hover:bg-zinc-800 hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary/50"
            aria-label="Toggle menu"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              width="24"
              height="24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
        <ul
          id="mobile-menu"
          class="absolute left-0 right-0 top-[56px] hidden divide-y divide-zinc-800/50 border-b border-zinc-800/50 bg-zinc-900/95 backdrop-blur-md transition-all duration-200 ease-in-out md:relative md:top-0 md:flex md:flex-row md:items-center md:justify-center md:space-x-1 md:divide-y-0 md:border-none md:bg-transparent md:p-0"
        >
          <li class="w-full md:w-auto">
            <a
              href="/"
              class="block px-6 py-3 text-sm font-medium tracking-wide text-zinc-400 transition-all hover:bg-zinc-800/50 hover:text-primary md:rounded-lg md:px-4 md:py-2"
              >Home</a
            >
          </li>
          <li class="w-full md:w-auto">
            <a
              href="https://manuelgil.me"
              target="_blank"
              rel="noopener noreferrer"
              class="block px-6 py-3 text-sm font-medium tracking-wide text-zinc-400 transition-all hover:bg-zinc-800/50 hover:text-primary md:rounded-lg md:px-4 md:py-2"
              >Open Source Projects</a
            >
          </li>
          <li class="w-full md:w-auto">
            <a
              href="/talks--communities"
              class="block px-6 py-3 text-sm font-medium tracking-wide text-zinc-400 transition-all hover:bg-zinc-800/50 hover:text-primary md:rounded-lg md:px-4 md:py-2"
              >Talks & Communities</a
            >
          </li>
          <li class="w-full md:w-auto">
            <a
              href="/how-to-support"
              class="block px-6 py-3 text-sm font-medium tracking-wide text-zinc-400 transition-all hover:bg-zinc-800/50 hover:text-primary md:rounded-lg md:px-4 md:py-2"
              >How to Support</a
            >
          </li>
          <li class="w-full md:w-auto">
            <a
              href="/why-sponsor"
              class="block px-6 py-3 text-sm font-medium tracking-wide text-zinc-400 transition-all hover:bg-zinc-800/50 hover:text-primary md:rounded-lg md:px-4 md:py-2"
              >Why Sponsor?</a
            >
          </li>
          <li class="w-full md:w-auto">
            <a
              href="/sponsors"
              class="block px-6 py-3 text-sm font-medium tracking-wide text-zinc-400 transition-all hover:bg-zinc-800/50 hover:text-primary md:rounded-lg md:px-4 md:py-2"
              >Sponsors</a
            >
          </li>
          <li class="w-full md:w-auto">
            <a
              href="/about-me"
              class="block px-6 py-3 text-sm font-medium tracking-wide text-zinc-400 transition-all hover:bg-zinc-800/50 hover:text-primary md:rounded-lg md:px-4 md:py-2"
              >About Me</a
            >
          </li>
          <li class="w-full md:w-auto">
            <a
              href="/blog"
              class="block px-6 py-3 text-sm font-medium tracking-wide text-zinc-400 transition-all hover:bg-zinc-800/50 hover:text-primary md:rounded-lg md:px-4 md:py-2"
              >Blog</a
            >
          </li>
        </ul>
      </nav>
    </header>

    <main class="flex-1 pt-16">
      <slot />
    </main>

    <footer class="mt-16 border-t border-zinc-800 py-8">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-zinc-400">
          Built with ❤️ for the developer community. Together, we build the future of tech.
        </p>
      </div>
    </footer>
  </body>
</html>
