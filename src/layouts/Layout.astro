---
/**
 * Main layout component for the entire site
 *
 * This component provides the foundational HTML structure for all pages including:
 * - Complete meta tags for SEO and social sharing
 * - Performance optimizations (preconnect, dns-prefetch, content-visibility)
 * - Structured data with JSON-LD for better search engine visibility
 * - Custom navigation handling for cross-browser compatibility
 * - Global styling and theme management
 *
 * @component
 * @example
 * ```astro
 * <Layout
 *   title="My Page Title"
 *   description="Detailed page description for SEO"
 *   keywords="keyword1, keyword2, keyword3"
 * >
 *   <YourPageContent />
 * </Layout>
 * ```
 */
import Footer from '../components/site/Footer.astro'
import Navigation from '../components/site/Navigation.astro'
import { siteConfig } from '../config/site'
import { getCleanPathname } from '../utils/url-utils'
import '../styles/global.css'

/**
 * Props for the Layout component
 */
interface Props {
  /**
   * Page title - will be used for both the browser tab and SEO
   */
  title: string
  /**
   * Meta description for SEO and social sharing cards
   */
  description?: string
  /**
   * Comma-separated keywords for SEO
   */
  keywords?: string
  /**
   * Open Graph image path for social sharing (optional)
   * If not provided, defaults to the site's avatar image
   */
  ogImage?: string
}

const {
  title,
  description,
  keywords,
  ogImage = 'https://avatars.githubusercontent.com/u/25472045',
} = Astro.props

// Get current path for navigation active state
// (normalized: static builds resolve Astro.url.pathname to the physical
// .html output filename, not the clean URL every internal link targets)
const currentPath = getCleanPathname(Astro.url.pathname)

// Generate canonical URL
const canonicalURL = new URL(currentPath, siteConfig.baseUrl)
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ff6b00" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>

    <!-- Preconnect and DNS Prefetch for performance optimization -->
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />
    <link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={`${siteConfig.name} - ${siteConfig.title}`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <meta property="twitter:creator" content={`@${siteConfig.social.twitter}`} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/blog/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Manuel Gil",
        "url": "https://imgil.dev/",
        "sameAs": [
          "https://github.com/ManuelGil",
          "https://www.linkedin.com/in/imgildev",
          "https://twitter.com/imgildev"
        ],
        "jobTitle": "Software Developer & Open Source Maintainer",
        "image": "https://avatars.githubusercontent.com/u/25472045"
      }
    </script>

    <!-- Performance optimizations and initialization -->
    <script>
      /**
       * Performance optimizations and cross-browser compatibility fixes
       *
       * This script:
       * 1. Initializes theme settings early for minimal flashing during page load
       * 2. Implements custom navigation to fix Chrome compatibility issues
       * 3. Applies content-visibility optimizations for better Core Web Vitals
       */
      import { initCustomNavigation } from '../utils/navigation-handler'
      import { applyContentVisibility, deferScript } from '../utils/performance-utils'
      import { initializeTheme } from '../utils/theme-utils'

      // Initialize theme settings early to prevent flash
      initializeTheme()

      // Defer non-critical operations until after page load
      deferScript(() => {
        // Initialize custom navigation handler that works in all browsers
        // This replaces the ClientRouter which had issues in Chrome
        initCustomNavigation('body')

        // Apply content visibility optimizations to sections below the fold
        // This improves rendering performance and Core Web Vitals
        applyContentVisibility('.content-visibility-auto')
      })
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-zinc-900 text-white">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <!-- Main navigation using the new component -->
    <Navigation currentPath={currentPath} />

    <!-- Main content area with content-visibility optimization -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Footer using the new component -->
    <Footer />
  </body>
</html>
